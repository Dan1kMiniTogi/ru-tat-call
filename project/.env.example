# Copy to `.env` in this directory (`project/.env`). Do not commit `.env`.

# Signaling HTTP + WebSocket (will also serve web_client static files).
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=8000

# ASR streaming WebSocket.
ASR_HOST=0.0.0.0
ASR_PORT=8001

# Comma-separated browser origins. Add the HTTPS tunnel URL when using ngrok/cloudflared.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SQLite file (relative to project/).
SQLITE_PATH=data/app.db

# Mobile-first HTML/JS client.
WEB_CLIENT_DIR=web_client

# Override before any real deploy. Tokens must not be logged.
SECRET_KEY=dev-only-change-me

# mock | remote (Colab) | local — engines land in later steps.
ASR_ENGINE=mock
ASR_REMOTE_URL=

MAX_PARTICIPANTS=4
